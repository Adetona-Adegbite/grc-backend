generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String    @id @default(uuid())
  email            String    @unique
  fullName         String?
  avatarUrl        String?
  password         String?
  googleId         String?   @unique
  createdAt        DateTime  @default(now())
  resetToken       String?
  resetTokenExpiry DateTime?

  ownedCompanies    Company[]          @relation("CompanyOwner")
  userCompanies     UserCompany[]
  ownedControls     Control[]          @relation("ControlOwner")
  sentInvites       Invite[]           @relation("InvitedBy")
  testPlanOverrides TestPlanOverride[] @relation("TestPlanTester")
  testerControls    Control[]          @relation("ControlTester")
  testResults       TestResult[]       @relation("TestResultTester")
  ownedIssues       Issue[]            @relation("IssueOwner")
  ownedActions      Action[]           @relation("ActionOwner")
  auditLogs         AuditLog[]
  createdAudits     Audit[]            @relation("AuditCreatedBy")
  receivedAudits    Audit[]            @relation("AuditRecipient")
  createdAuditIssues AuditIssue[]      @relation("AuditIssueCreatedBy")
  auditComments     AuditComment[]     @relation("AuditCommentAuthor")

  @@map("users")
}

model Company {
  id                 String   @id @default(uuid())
  name               String
  slug               String   @unique
  ownerId            String
  financialYearStart Int      @default(1)
  createdAt          DateTime @default(now())

  owner             User               @relation("CompanyOwner", fields: [ownerId], references: [id])
  userCompanies     UserCompany[]
  countries         Country[]
  controls          Control[]
  invites           Invite[]
  testPlanOverrides TestPlanOverride[]
  TestResult        TestResult[]
  issues            Issue[]
  actions           Action[]
  auditLogs         AuditLog[]
  audits            Audit[]
  auditPeriods      AuditPeriod[]
  auditIssues       AuditIssue[]
  auditComments     AuditComment[]

  @@map("companies")
}

model UserCompany {
  id        String   @id @default(uuid())
  userId    String
  companyId String
  role      Role     @default(viewer)
  invitedBy String?
  joinedAt  DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id])
  company Company @relation(fields: [companyId], references: [id])

  @@unique([userId, companyId])
  @@map("user_company")
}

enum Role {
  admin
  control_owner
  tester
  viewer
}

model Country {
  id        String   @id @default(uuid())
  companyId String
  name      String
  code      String
  createdAt DateTime @default(now())

  company     Company      @relation(fields: [companyId], references: [id])
  controls    Control[]
  testResults TestResult[]
  issues      Issue[]
  audits      Audit[]

  @@unique([companyId, code])
  @@map("countries")
}

model Control {
  id          String        @id @default(uuid())
  companyId   String
  countryId   String
  controlId   String
  description String
  name        String
  domain      String
  risk        String
  frequency   Frequency
  ownerId     String?
  testerId    String?
  nature      Nature
  type        ControlType
  testDueDay  Int           @default(15)
  testDueDate DateTime?
  status      ControlStatus @default(active)
  createdAt   DateTime      @default(now())

  company           Company            @relation(fields: [companyId], references: [id])
  country           Country            @relation(fields: [countryId], references: [id])
  owner             User?              @relation("ControlOwner", fields: [ownerId], references: [id])
  tester            User?              @relation("ControlTester", fields: [testerId], references: [id])
  testPlanOverrides TestPlanOverride[]
  testResults       TestResult[]
  issues            Issue[]
  audits            Audit[]

  @@unique([companyId, controlId, countryId])
  @@map("controls")
}

enum Nature {
  manual
  automated
}

enum ControlType {
  preventive
  detective
  corrective
}

enum Frequency {
  monthly
  quarterly
  semi_annually
  annual
  as_needed
}

enum ControlStatus {
  active
  inactive
}

model TestResult {
  id            String           @id @default(uuid())
  testId        String
  companyId     String
  countryId     String
  controlId     String
  testerId      String
  period        String
  testName      String
  population    Int
  sampleSize    Int
  exceptions    Int
  result        TestResultStatus
  testProcedure String?
  evidenceUrl   String?
  evidenceUrls  String[]         @default([])
  recommendation String?
  comments      String?
  testedAt      DateTime         @default(now())
  createdAt     DateTime         @default(now())

  company Company @relation(fields: [companyId], references: [id])
  country Country @relation(fields: [countryId], references: [id])
  control Control @relation(fields: [controlId], references: [id])
  tester  User    @relation("TestResultTester", fields: [testerId], references: [id])
  issues  Issue[]

  @@unique([companyId, controlId, period])
  @@unique([companyId, testId])
  @@map("test_results")
}

// "Exception" was merged into "fail": the business treats an exception as a
// failure, and having both invited inconsistent recording. The `exceptions`
// column below is a COUNT of failed items in the sample, which is a different
// thing and is surfaced in the UI as "Failed Items".
enum TestResultStatus {
  pass
  fail
}

model Invite {
  id        String       @id @default(uuid())
  companyId String
  email     String
  role      Role
  token     String       @unique @default(uuid())
  status    InviteStatus @default(pending)
  invitedBy String
  createdAt DateTime     @default(now())
  expiresAt DateTime

  company Company @relation(fields: [companyId], references: [id])
  inviter User    @relation("InvitedBy", fields: [invitedBy], references: [id])

  @@map("invites")
}

enum InviteStatus {
  pending
  accepted
  expired
  declined
}

model TestPlanOverride {
  id        String   @id @default(uuid())
  companyId String
  controlId String
  testerId  String
  period    String
  createdAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id])
  control Control @relation(fields: [controlId], references: [id])
  tester  User    @relation("TestPlanTester", fields: [testerId], references: [id])

  @@unique([companyId, controlId, period])
  @@map("test_plan_overrides")
}

model Issue {
  id           String      @id @default(uuid())
  issueId      String
  companyId    String
  countryId    String
  controlId    String
  testResultId String?
  description  String
  severity     Severity    @default(medium)
  ownerId      String?
  dueDate      DateTime?
  status       IssueStatus @default(open)
  evidenceUrl  String?
  createdAt    DateTime    @default(now())
  testerClosed Boolean     @default(false)

  company    Company     @relation(fields: [companyId], references: [id])
  country    Country     @relation(fields: [countryId], references: [id])
  control    Control     @relation(fields: [controlId], references: [id])
  testResult TestResult? @relation(fields: [testResultId], references: [id])
  owner      User?       @relation("IssueOwner", fields: [ownerId], references: [id])
  actions    Action[]

  @@unique([companyId, issueId])
  @@map("issues")
}

model Action {
  id          String       @id @default(uuid())
  actionId    String
  issueId     String
  companyId   String
  description String
  ownerId     String?
  dueDate     DateTime?
  progress    Int          @default(0)
  status      ActionStatus @default(in_progress)
  lastUpdate  DateTime     @default(now())
  createdAt   DateTime     @default(now())

  issue   Issue   @relation(fields: [issueId], references: [id])
  company Company @relation(fields: [companyId], references: [id])
  owner   User?   @relation("ActionOwner", fields: [ownerId], references: [id])

  @@unique([companyId, actionId])
  @@map("actions")
}

enum Severity {
  low
  medium
  high
}

enum IssueStatus {
  open
  in_progress
  closed
}

enum ActionStatus {
  in_progress
  completed
}

model AuditLog {
  id         String   @id @default(uuid())
  companyId  String
  userId     String
  action     String
  entityType String
  entityId   String
  detail     String?
  createdAt  DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}

// An audit engagement raised against a control that has failed tests.
// Frequency is not stored: it is always read from the audited control so the
// audit can never drift from the control's schedule.
model Audit {
  id          String   @id @default(uuid())
  auditId     String
  companyId   String
  countryId   String
  controlId   String
  areaProcess String?
  auditName   String
  objectives  String?
  scope       String?
  keyRisks    String?
  lead        String?
  procedures  String?
  startMonth  String
  dueDay      Int      @default(15)
  createdById String
  // Who is being asked to respond. Any user may be chosen; the recipient sees
  // only the audits addressed to them.
  recipientId String?
  createdAt   DateTime @default(now())

  company   Company        @relation(fields: [companyId], references: [id])
  country   Country        @relation(fields: [countryId], references: [id])
  control   Control        @relation(fields: [controlId], references: [id])
  createdBy User           @relation("AuditCreatedBy", fields: [createdById], references: [id])
  recipient User?          @relation("AuditRecipient", fields: [recipientId], references: [id])
  periods   AuditPeriod[]
  comments  AuditComment[]

  @@unique([companyId, auditId])
  @@unique([companyId, controlId])
  @@map("audits")
}

// One occurrence of an audit for a single period, carrying that period's own
// evidence and issues.
model AuditPeriod {
  id           String    @id @default(uuid())
  auditId      String
  companyId    String
  period       String
  dueDate      DateTime?
  evidenceUrls String[]  @default([])
  createdAt    DateTime  @default(now())

  audit   Audit        @relation(fields: [auditId], references: [id])
  company Company      @relation(fields: [companyId], references: [id])
  issues  AuditIssue[]

  @@unique([auditId, period])
  @@map("audit_periods")
}

// Audit findings live only in the Audit tab and are deliberately separate from
// the Issue model used by test exceptions.
model AuditIssue {
  id            String      @id @default(uuid())
  auditIssueId  String
  companyId     String
  auditPeriodId String
  description   String
  severity      Severity    @default(medium)
  status        IssueStatus @default(open)
  evidenceUrls  String[]    @default([])
  createdById   String
  createdAt     DateTime    @default(now())

  company     Company     @relation(fields: [companyId], references: [id])
  auditPeriod AuditPeriod @relation(fields: [auditPeriodId], references: [id])
  createdBy   User        @relation("AuditIssueCreatedBy", fields: [createdById], references: [id])

  @@unique([companyId, auditIssueId])
  @@map("audit_issues")
}

// Conversation on an audit. A comment flagged as a request emails the audit's
// recipient — that is the only thing that triggers a notification.
model AuditComment {
  id           String   @id @default(uuid())
  auditId      String
  companyId    String
  authorId     String
  message      String
  period       String?
  isRequest    Boolean  @default(false)
  evidenceUrls String[] @default([])
  createdAt    DateTime @default(now())

  audit   Audit   @relation(fields: [auditId], references: [id])
  company Company @relation(fields: [companyId], references: [id])
  author  User    @relation("AuditCommentAuthor", fields: [authorId], references: [id])

  @@map("audit_comments")
}
